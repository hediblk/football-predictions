{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "scoreMetrics": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "log_loss": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "brier": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "rps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "n",
        "log_loss",
        "brier",
        "rps"
      ]
    },
    "scoreBaseline": {
      "allOf": [
        {
          "$ref": "#/$defs/scoreMetrics"
        },
        {
          "type": "object",
          "properties": {
            "model": {
              "$ref": "#/$defs/scoreMetrics"
            }
          },
          "required": [
            "model"
          ]
        }
      ]
    },
    "frequencyBaseline": {
      "type": "object",
      "properties": {
        "seasons": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true,
          "maxItems": 5
        },
        "requested_seasons": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "p": {
          "anyOf": [
            {
              "$ref": "#/$defs/match/properties/p"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "seasons",
        "requested_seasons",
        "n",
        "p"
      ]
    },
    "calibrationBin": {
      "type": "object",
      "properties": {
        "lo": {
          "$ref": "#/$defs/probability"
        },
        "hi": {
          "$ref": "#/$defs/probability"
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "probability": {
          "anyOf": [
            {
              "$ref": "#/$defs/probability"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed": {
          "anyOf": [
            {
              "$ref": "#/$defs/probability"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lo",
        "hi",
        "n",
        "probability",
        "observed"
      ]
    },
    "scoreWeek": {
      "type": "object",
      "properties": {
        "week": {
          "$ref": "#/$defs/date"
        },
        "model": {
          "$ref": "#/$defs/scoreMetrics"
        },
        "frequency": {
          "$ref": "#/$defs/scoreMetrics"
        },
        "elo": {
          "$ref": "#/$defs/scoreMetrics"
        }
      },
      "required": [
        "week",
        "model",
        "frequency",
        "elo"
      ]
    },
    "scoreRecord": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "n_published": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "$ref": "#/$defs/scoreMetrics"
        },
        "baselines": {
          "type": "object",
          "properties": {
            "frequency": {
              "$ref": "#/$defs/scoreBaseline"
            },
            "elo": {
              "$ref": "#/$defs/scoreBaseline"
            }
          },
          "required": [
            "frequency",
            "elo"
          ]
        },
        "called": {
          "type": "integer",
          "minimum": 0
        },
        "exact": {
          "type": "integer",
          "minimum": 0
        },
        "avg_chance_given": {
          "anyOf": [
            {
              "$ref": "#/$defs/probability"
            },
            {
              "type": "null"
            }
          ]
        },
        "calibration": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/calibrationBin"
          },
          "minItems": 10,
          "maxItems": 10
        },
        "weekly": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scoreWeek"
          }
        },
        "market": {
          "type": "null"
        }
      },
      "required": [
        "n",
        "n_published",
        "model",
        "baselines",
        "called",
        "exact",
        "avg_chance_given",
        "calibration",
        "weekly",
        "market"
      ]
    },
    "scoreEntry": {
      "allOf": [
        {
          "$ref": "#/$defs/scoreRecord"
        },
        {
          "type": "object",
          "properties": {
            "published": {
              "$ref": "#/$defs/scoreRecord"
            },
            "reconstructed": {
              "$ref": "#/$defs/scoreRecord"
            }
          },
          "required": [
            "published",
            "reconstructed"
          ]
        }
      ]
    },
    "competitionScore": {
      "allOf": [
        {
          "$ref": "#/$defs/scoreEntry"
        },
        {
          "type": "object",
          "properties": {
            "season": {
              "$ref": "#/$defs/season"
            },
            "generated_at": {
              "$ref": "#/$defs/timestamp"
            },
            "frequency_baseline": {
              "anyOf": [
                {
                  "$ref": "#/$defs/frequencyBaseline"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "season",
            "generated_at",
            "frequency_baseline"
          ]
        }
      ]
    },
    "scorecard": {
      "type": "object",
      "properties": {
        "generated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "competitions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/competitionSlug"
          },
          "additionalProperties": {
            "$ref": "#/$defs/competitionScore"
          }
        },
        "all": {
          "$ref": "#/$defs/scoreEntry"
        }
      },
      "required": [
        "generated_at",
        "competitions",
        "all"
      ]
    },
    "string": {"type":"string","minLength":1},
    "slug": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "competitionSlug": {"enum":["premier-league","la-liga","bundesliga","serie-a","ligue-1","champions-league"]},
    "leagueSlug": {"enum":["premier-league","la-liga","bundesliga","serie-a","ligue-1"]},
    "season": {"type":"string","pattern":"^[0-9]{4}/[0-9]{2}$"},
    "timestamp": {"type":"string","format":"date-time"},
    "date": {"type":"string","format":"date"},
    "id": {"anyOf":[{"type":"integer","minimum":1},{"type":"null"}]},
    "probability": {"type":"number","minimum":0,"maximum":1},
    "percentage": {"type":"number","minimum":0,"maximum":100},
    "nullablePercentage": {"anyOf":[{"$ref":"#/$defs/percentage"},{"type":"null"}]},
    "identity": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "slug": {"$ref":"#/$defs/slug"},
        "name": {"$ref":"#/$defs/string"},
        "full": {"$ref":"#/$defs/string"}
      },
      "required": ["id","slug","name","full"]
    },
    "indexEntry": {
      "type": "object",
      "properties": {
        "slug": {"$ref":"#/$defs/competitionSlug"},
        "code": {"$ref":"#/$defs/string"},
        "name": {"$ref":"#/$defs/string"},
        "country": {"$ref":"#/$defs/string"},
        "season": {"$ref":"#/$defs/season"},
        "generated_at": {"$ref":"#/$defs/timestamp"}
      },
      "required": ["slug","code","name","country","season","generated_at"]
    },
    "index": {"type":"array","items":{"$ref":"#/$defs/indexEntry"},"minItems":1},
    "zone": {
      "type": "object",
      "properties": {
        "key": {"$ref":"#/$defs/slug"},
        "label": {"$ref":"#/$defs/string"},
        "from": {"type":"integer","minimum":1},
        "to": {"type":"integer","minimum":1}
      },
      "required": ["key","label","from","to"]
    },
    "competition": {
      "type": "object",
      "properties": {
        "slug": {"$ref":"#/$defs/competitionSlug"},
        "kind": {"enum":["league","ucl"]},
        "code": {"$ref":"#/$defs/string"},
        "name": {"$ref":"#/$defs/string"},
        "country": {"$ref":"#/$defs/string"},
        "season": {"$ref":"#/$defs/season"},
        "generated_at": {"$ref":"#/$defs/timestamp"},
        "as_of": {"$ref":"#/$defs/timestamp"},
        "data_cutoff": {"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "n_sim": {"type":"integer","minimum":1},
        "played_fixtures": {"type":"integer","minimum":0},
        "remaining_fixtures": {"type":"integer","minimum":0},
        "zones": {"type":"array","items":{"$ref":"#/$defs/zone"},"minItems":1}
      },
      "required": [
        "slug",
        "kind",
        "code",
        "name",
        "country",
        "season",
        "generated_at",
        "as_of",
        "data_cutoff",
        "n_sim",
        "played_fixtures",
        "remaining_fixtures",
        "zones"
      ]
    },
    "team": {
      "allOf": [
        {"$ref":"#/$defs/identity"},
        {
          "type": "object",
          "properties": {
            "position": {"type":"integer","minimum":1},
            "played": {"type":"integer","minimum":0},
            "points": {"type":"integer"},
            "gd": {"type":"integer"},
            "xpts": {"type":"number"},
            "p10": {"type":"integer"},
            "p90": {"type":"integer"},
            "xpos": {"type":"number","minimum":1},
            "title": {"$ref":"#/$defs/percentage"},
            "probs": {"type":"array","items":{"$ref":"#/$defs/percentage"},"minItems":1}
          },
          "required": ["position","played","points","gd","xpts","p10","p90","xpos","title","probs"]
        }
      ]
    },
    "leagueTeam": {
      "allOf": [
        {"$ref":"#/$defs/team"},
        {
          "type": "object",
          "properties": {
            "ucl": {"$ref":"#/$defs/percentage"},
            "europe": {"$ref":"#/$defs/percentage"},
            "releg": {"$ref":"#/$defs/percentage"}
          },
          "required": ["ucl","europe","releg"]
        }
      ]
    },
    "uclTeam": {
      "allOf": [
        {"$ref":"#/$defs/team"},
        {
          "type": "object",
          "properties": {
            "key": {"$ref":"#/$defs/string"},
            "r16": {"$ref":"#/$defs/percentage"},
            "playoff": {"$ref":"#/$defs/percentage"},
            "out": {"$ref":"#/$defs/percentage"},
            "stages": {
              "type": "object",
              "properties": {
                "round16": {"$ref":"#/$defs/percentage"},
                "quarterfinal": {"$ref":"#/$defs/percentage"},
                "semifinal": {"$ref":"#/$defs/percentage"},
                "final": {"$ref":"#/$defs/percentage"}
              },
              "required": ["round16","quarterfinal","semifinal","final"]
            }
          },
          "required": ["key","r16","playoff","out","stages"]
        }
      ]
    },
    "fixtureNote": {
      "type": "object",
      "properties": {
        "home": {"$ref":"#/$defs/string"},
        "away": {"$ref":"#/$defs/string"},
        "kickoff": {"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "reported_status": {"$ref":"#/$defs/string"},
        "used_status": {"$ref":"#/$defs/string"},
        "score": {"anyOf":[{"$ref":"#/$defs/string"},{"type":"null"}]},
        "reason": {"$ref":"#/$defs/string"}
      },
      "required": ["home","away","kickoff","reported_status","used_status","score","reason"]
    },
    "tie": {
      "type": "object",
      "properties": {
        "team1": {"$ref":"#/$defs/string"},
        "team2": {"$ref":"#/$defs/string"},
        "winner": {"$ref":"#/$defs/string"},
        "team1_id": {"$ref":"#/$defs/id"},
        "team2_id": {"$ref":"#/$defs/id"},
        "winner_id": {"$ref":"#/$defs/id"},
        "advance": {"type":"number","minimum":50,"maximum":100},
        "observed": {"type":"boolean"}
      },
      "required": ["team1","team2","winner","team1_id","team2_id","winner_id","advance","observed"]
    },
    "bracket": {
      "type": "object",
      "properties": {
        "stages": {
          "type": "object",
          "properties": {
            "playoffs": {"type":"array","items":{"$ref":"#/$defs/tie"},"minItems":8,"maxItems":8},
            "round16": {"type":"array","items":{"$ref":"#/$defs/tie"},"minItems":8,"maxItems":8},
            "quarterfinal": {"type":"array","items":{"$ref":"#/$defs/tie"},"minItems":4,"maxItems":4},
            "semifinal": {"type":"array","items":{"$ref":"#/$defs/tie"},"minItems":2,"maxItems":2},
            "final": {"type":"array","items":{"$ref":"#/$defs/tie"},"minItems":1,"maxItems":1}
          },
          "required": ["playoffs","round16","quarterfinal","semifinal","final"]
        },
        "champion": {"$ref":"#/$defs/string"},
        "champion_id": {"$ref":"#/$defs/id"},
        "note": {"$ref":"#/$defs/string"},
        "seeds": {"type":"array","items":{"$ref":"#/$defs/string"},"minItems":0}
      },
      "required": ["stages","champion","champion_id","note"]
    },
    "league": {
      "allOf": [
        {"$ref":"#/$defs/competition"},
        {
          "type": "object",
          "properties": {
            "kind": {"const":"league"},
            "teams": {"type":"array","items":{"$ref":"#/$defs/leagueTeam"},"minItems":1},
            "fixture_notes": {"type":"array","items":{"$ref":"#/$defs/fixtureNote"},"minItems":0}
          },
          "required": ["teams"]
        }
      ]
    },
    "ucl": {
      "allOf": [
        {"$ref":"#/$defs/competition"},
        {
          "type": "object",
          "properties": {
            "kind": {"const":"ucl"},
            "slug": {"const":"champions-league"},
            "data_cutoff": {"$ref":"#/$defs/timestamp"},
            "teams": {"type":"array","items":{"$ref":"#/$defs/uclTeam"},"minItems":36,"maxItems":36},
            "bracket": {"$ref":"#/$defs/bracket"}
          },
          "required": ["kind","slug","data_cutoff","teams","bracket"]
        }
      ]
    },
    "score": {
      "type": "array",
      "prefixItems": [{"type":"integer","minimum":0},{"type":"integer","minimum":0}],
      "minItems": 2,
      "maxItems": 2
    },
    "goalPair": {
      "type": "array",
      "prefixItems": [{"type":"number","minimum":0},{"type":"number","minimum":0}],
      "minItems": 2,
      "maxItems": 2
    },
    "scoreProbability": {
      "type": "array",
      "prefixItems": [{"type":"integer","minimum":0},{"type":"integer","minimum":0},{"$ref":"#/$defs/probability"}],
      "minItems": 3,
      "maxItems": 3
    },
    "stakesTeam": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "name": {"$ref":"#/$defs/string"},
        "title": {
          "type": "array",
          "prefixItems": [
            {"$ref":"#/$defs/nullablePercentage"},
            {"$ref":"#/$defs/nullablePercentage"},
            {"$ref":"#/$defs/nullablePercentage"}
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "ucl": {
          "type": "array",
          "prefixItems": [
            {"$ref":"#/$defs/nullablePercentage"},
            {"$ref":"#/$defs/nullablePercentage"},
            {"$ref":"#/$defs/nullablePercentage"}
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "releg": {
          "type": "array",
          "prefixItems": [
            {"$ref":"#/$defs/nullablePercentage"},
            {"$ref":"#/$defs/nullablePercentage"},
            {"$ref":"#/$defs/nullablePercentage"}
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "top8": {
          "type": "array",
          "prefixItems": [
            {"$ref":"#/$defs/nullablePercentage"},
            {"$ref":"#/$defs/nullablePercentage"},
            {"$ref":"#/$defs/nullablePercentage"}
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "top24": {
          "type": "array",
          "prefixItems": [
            {"$ref":"#/$defs/nullablePercentage"},
            {"$ref":"#/$defs/nullablePercentage"},
            {"$ref":"#/$defs/nullablePercentage"}
          ],
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": ["id","name"]
    },
    "stakes": {
      "type": "object",
      "properties": {
        "n": {
          "type": "array",
          "prefixItems": [{"type":"integer","minimum":0},{"type":"integer","minimum":0},{"type":"integer","minimum":0}],
          "minItems": 3,
          "maxItems": 3
        },
        "teams": {"type":"array","items":{"$ref":"#/$defs/stakesTeam"},"minItems":1}
      },
      "required": ["n","teams"]
    },
    "match": {
      "type": "object",
      "properties": {
        "elo": {"$ref":"#/$defs/match/properties/p"},
        "id": {"type":"integer","minimum":1},
        "kickoff": {"$ref":"#/$defs/timestamp"},
        "status": {"$ref":"#/$defs/string"},
        "md": {"anyOf":[{"type":"integer","minimum":1},{"type":"null"}]},
        "home": {"$ref":"#/$defs/string"},
        "away": {"$ref":"#/$defs/string"},
        "home_id": {"$ref":"#/$defs/id"},
        "away_id": {"$ref":"#/$defs/id"},
        "score": {"$ref":"#/$defs/score"},
        "xg": {"$ref":"#/$defs/goalPair"},
        "p": {
          "type": "array",
          "prefixItems": [{"$ref":"#/$defs/probability"},{"$ref":"#/$defs/probability"},{"$ref":"#/$defs/probability"}],
          "minItems": 3,
          "maxItems": 3
        },
        "exp": {"$ref":"#/$defs/goalPair"},
        "top": {"type":"array","items":{"$ref":"#/$defs/scoreProbability"},"minItems":1},
        "btts": {"$ref":"#/$defs/probability"},
        "o25": {"$ref":"#/$defs/probability"},
        "at": {"$ref":"#/$defs/timestamp"},
        "call": {"$ref":"#/$defs/scoreProbability"},
        "p_score": {"$ref":"#/$defs/probability"},
        "reported": {"$ref":"#/$defs/string"},
        "stage": {"$ref":"#/$defs/string"},
        "neutral": {"type":"boolean"},
        "published": {"type":"boolean"},
        "stakes": {"$ref":"#/$defs/stakes"}
      },
      "required": ["id","kickoff","status","md","home","away","home_id","away_id"],
      "allOf": [
        {"if":{"required":["p"]},"then":{"required":["exp","top","btts","o25","at"]}},
        {
          "if": {"properties":{"status":{"const":"FINISHED"}},"required":["status"]},
          "then": {"required":["score"]}
        }
      ]
    },
    "shot": {
      "type": "array",
      "prefixItems": [
        {"type":"integer","minimum":0}, {"enum":["h","a"]},
        {"$ref":"#/$defs/probability"}, {"$ref":"#/$defs/probability"}, {"$ref":"#/$defs/probability"},
        {"$ref":"#/$defs/string"}, {"$ref":"#/$defs/string"}, {"$ref":"#/$defs/string"}, {"$ref":"#/$defs/string"},
        {"anyOf":[{"$ref":"#/$defs/string"},{"type":"null"}]}
      ],
      "minItems": 10,
      "maxItems": 10
    },
    "matchPlayer": {
      "type": "object",
      "properties": {
        "id": {"type":"integer","minimum":1},
        "player": {"$ref":"#/$defs/string"},
        "minutes": {"type":"integer","minimum":0},
        "position": {"$ref":"#/$defs/string"},
        "shots": {"type":"integer","minimum":0},
        "goals": {"type":"integer","minimum":0},
        "own_goals": {"type":"integer","minimum":0},
        "xg": {"type":"number","minimum":0},
        "xa": {"type":"number","minimum":0},
        "key_passes": {"type":"integer","minimum":0},
        "yellow": {"type":"integer","minimum":0},
        "red": {"type":"integer","minimum":0}
      },
      "required": ["id","player","minutes","position","shots","goals","own_goals","xg","xa","key_passes","yellow","red"]
    },
    "matchEvent": {
      "type": "object",
      "properties": {
        "minute": {"type":"integer","minimum":0},
        "clock": {"type":"string","pattern":"^[0-9]+(\\+[0-9]+)?$"},
        "type": {"enum":["goal","own_goal","penalty_goal","missed_penalty","yellow","red","substitution"]},
        "side": {"enum":["h","a"]},
        "players": {"type":"array","items":{"$ref":"#/$defs/string"},"minItems":1}
      },
      "required": ["minute","clock","type","side","players"]
    },
    "statPair": {
      "type":"array","items":{"type":"integer","minimum":0},"minItems":2,"maxItems":2
    },
    "percentPair": {
      "type":"array","items":{"type":"number","minimum":0,"maximum":100},"minItems":2,"maxItems":2
    },
    "match_events": {
      "type": "object",
      "properties": {
        "id": {"type":"integer","minimum":1},
        "competition": {"$ref":"#/$defs/competitionSlug"},
        "kickoff": {"$ref":"#/$defs/timestamp"},
        "sources": {
          "type": "object",
          "properties": {
            "espn": {
              "type": "object",
              "properties": {
                "id": {"type":"integer","minimum":1},
                "fetched_at": {"$ref":"#/$defs/timestamp"},
                "score": {"$ref":"#/$defs/goalPair"}
              },
              "required": ["id","fetched_at","score"]
            },
            "understat": {
              "type": "object",
              "properties": {
                "id": {"type":"integer","minimum":1},
                "fetched_at": {"$ref":"#/$defs/timestamp"}
              },
              "required": ["id","fetched_at"]
            }
          }
        },
        "box": {
          "type": "object",
          "properties": {
            "possession": {"$ref":"#/$defs/percentPair"},
            "shots": {"$ref":"#/$defs/statPair"},
            "shots_on_target": {"$ref":"#/$defs/statPair"},
            "corners": {"$ref":"#/$defs/statPair"},
            "fouls": {"$ref":"#/$defs/statPair"},
            "offsides": {"$ref":"#/$defs/statPair"},
            "saves": {"$ref":"#/$defs/statPair"},
            "pass_accuracy": {"$ref":"#/$defs/percentPair"},
            "yellow": {"$ref":"#/$defs/statPair"},
            "red": {"$ref":"#/$defs/statPair"}
          },
          "minProperties": 1
        },
        "events": {"type":"array","items":{"$ref":"#/$defs/matchEvent"}},
        "shots": {"type":"array","items":{"$ref":"#/$defs/shot"}},
        "players": {
          "type": "object",
          "properties": {
            "h": {"type":"array","items":{"$ref":"#/$defs/matchPlayer"}},
            "a": {"type":"array","items":{"$ref":"#/$defs/matchPlayer"}}
          },
          "required": ["h","a"]
        },
        "retro": {"type":"array","items":{"$ref":"#/$defs/probability"},"minItems":3,"maxItems":3}
      },
      "required": ["id","competition","kickoff","sources"]
    },
    "forecastReceipt": {
      "type": "object",
      "properties": {
        "kickoff": {"$ref":"#/$defs/timestamp"},
        "generated_at": {"$ref":"#/$defs/timestamp"},
        "p": {"$ref":"#/$defs/match/properties/p"},
        "elo": {"$ref":"#/$defs/match/properties/p"},
        "exp": {"$ref":"#/$defs/goalPair"},
        "top": {"type":"array","items":{"$ref":"#/$defs/scoreProbability"},"minItems":1},
        "call": {"$ref":"#/$defs/scoreProbability"},
        "btts": {"$ref":"#/$defs/probability"},
        "o25": {"$ref":"#/$defs/probability"},
        "stakes": {"$ref":"#/$defs/stakes"}
      },
      "required": ["kickoff","generated_at","p","exp","top","call","btts","o25"]
    },
    "forecast_receipts": {
      "type": "object",
      "properties": {
        "slug": {"$ref":"#/$defs/competitionSlug"},
        "season": {"$ref":"#/$defs/season"},
        "fixtures": {
          "type": "object",
          "propertyNames": {"pattern":"^[1-9][0-9]*$"},
          "additionalProperties": {"$ref":"#/$defs/forecastReceipt"}
        }
      },
      "required": ["slug","season","fixtures"]
    },
    "matches": {
      "type": "object",
      "properties": {
        "slug": {"$ref":"#/$defs/competitionSlug"},
        "generated_at": {"$ref":"#/$defs/timestamp"},
        "rule": {"anyOf":[{"$ref":"#/$defs/string"},{"type":"null"}]},
        "matches": {"type":"array","items":{"$ref":"#/$defs/match"},"minItems":0}
      },
      "required": ["slug","generated_at","rule","matches"],
      "allOf": [
        {
          "if": {"properties":{"slug":{"const":"champions-league"}}},
          "then": {"properties":{"matches":{"minItems":1}}}
        }
      ]
    },
    "club": {
      "allOf": [
        {"$ref":"#/$defs/identity"},
        {
          "type": "object",
          "properties": {
            "rating": {"$ref":"#/$defs/percentage"},
            "attack": {"$ref":"#/$defs/percentage"},
            "defense": {"$ref":"#/$defs/percentage"},
            "home": {"$ref":"#/$defs/percentage"},
            "away": {"$ref":"#/$defs/percentage"},
            "league_rating": {"$ref":"#/$defs/percentage"},
            "rating_rank": {"type":"integer","minimum":1},
            "attack_rank": {"type":"integer","minimum":1},
            "defense_rank": {"type":"integer","minimum":1},
            "league_rank": {"anyOf":[{"type":"integer","minimum":1},{"type":"null"}]},
            "league": {"anyOf":[{"$ref":"#/$defs/leagueSlug"},{"type":"null"}]},
            "country": {"$ref":"#/$defs/string"},
            "country_code": {"$ref":"#/$defs/string"},
            "ucl": {"type":"boolean"},
            "gf": {"type":"number","minimum":0},
            "ga": {"type":"number","minimum":0}
          },
          "required": [
            "rating",
            "attack",
            "defense",
            "home",
            "away",
            "league_rating",
            "rating_rank",
            "attack_rank",
            "defense_rank",
            "league_rank",
            "league",
            "ucl",
            "gf",
            "ga"
          ]
        },
        {
          "if": {"properties":{"league":{"type":"null"}},"required":["league"]},
          "then": {"required":["country","country_code"],"properties":{"league_rank":{"type":"null"},"ucl":{"const":true}}},
          "else": {"properties":{"league_rank":{"type":"integer"}}}
        }
      ]
    },
    "clubs": {
      "type": "object",
      "properties": {
        "generated_at": {"$ref":"#/$defs/timestamp"},
        "season": {"$ref":"#/$defs/season"},
        "scale": {
          "type": "object",
          "properties": {
            "reference": {"$ref":"#/$defs/string"},
            "clubs": {"type":"integer","minimum":1},
            "leagues": {"type":"integer","minimum":1}
          },
          "required": ["reference","clubs","leagues"]
        },
        "league_averages": {
          "type": "object",
          "properties": {
            "premier-league": {"$ref":"#/$defs/percentage"},
            "la-liga": {"$ref":"#/$defs/percentage"},
            "bundesliga": {"$ref":"#/$defs/percentage"},
            "serie-a": {"$ref":"#/$defs/percentage"},
            "ligue-1": {"$ref":"#/$defs/percentage"}
          },
          "required": ["premier-league","la-liga","bundesliga","serie-a","ligue-1"]
        },
        "featured": {"type":"array","items":{"type":"integer","minimum":1},"minItems":0},
        "clubs": {"type":"array","items":{"$ref":"#/$defs/club"},"minItems":1}
      },
      "required": ["generated_at","season","scale","league_averages","featured","clubs"]
    },
    "crest": {
      "type": "object",
      "properties": {
        "name": {"$ref":"#/$defs/string"},
        "source": {"type":"string","format":"uri"},
        "path": {"type":"string","pattern":"^assets/crests/[a-zA-Z0-9_-]+\\.(svg|png)$"},
        "width": {"type":"integer","minimum":1},
        "height": {"type":"integer","minimum":1}
      },
      "required": ["name","source","path"],
      "allOf": [{"if":{"properties":{"path":{"pattern":"\\.png$"}}},"then":{"required":["width","height"]}}]
    },
    "crests": {
      "type": "object",
      "propertyNames": {"pattern":"^[1-9][0-9]*$"},
      "additionalProperties": {"$ref":"#/$defs/crest"}
    },
    "historyTeam": {
      "type": "object",
      "properties": {
        "id": {"anyOf":[{"type":"integer","minimum":1},{"$ref":"#/$defs/slug"}]},
        "name": {"$ref":"#/$defs/string"},
        "title": {"type":"array","items":{"$ref":"#/$defs/nullablePercentage"},"minItems":0},
        "ucl": {"type":"array","items":{"$ref":"#/$defs/nullablePercentage"},"minItems":0},
        "releg": {"type":"array","items":{"$ref":"#/$defs/nullablePercentage"},"minItems":0},
        "top8": {"type":"array","items":{"$ref":"#/$defs/nullablePercentage"},"minItems":0},
        "top24": {"type":"array","items":{"$ref":"#/$defs/nullablePercentage"},"minItems":0},
        "last16": {"type":"array","items":{"$ref":"#/$defs/nullablePercentage"},"minItems":0},
        "qf": {"type":"array","items":{"$ref":"#/$defs/nullablePercentage"},"minItems":0},
        "sf": {"type":"array","items":{"$ref":"#/$defs/nullablePercentage"},"minItems":0},
        "final": {"type":"array","items":{"$ref":"#/$defs/nullablePercentage"},"minItems":0}
      },
      "required": ["id","name"]
    },
    "history": {
      "type": "object",
      "properties": {
        "slug": {"$ref":"#/$defs/competitionSlug"},
        "season": {"$ref":"#/$defs/season"},
        "metrics": {"type":"array"},
        "dates": {"type":"array","items":{"$ref":"#/$defs/date"},"minItems":0},
        "cutoff": {"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "teams": {"type":"array","items":{"$ref":"#/$defs/historyTeam"},"minItems":0}
      },
      "required": ["slug","season","metrics","dates","cutoff","teams"],
      "allOf": [
        {
          "if": {"properties":{"slug":{"const":"champions-league"}}},
          "then": {"properties":{"metrics":{"const":["top8","top24","last16","qf","sf","final","title"]}}},
          "else": {"properties":{"metrics":{"const":["title","ucl","releg"]}}}
        }
      ]
    },
    "week": {
      "type": "object",
      "properties": {
        "date": {"$ref":"#/$defs/date"},
        "cutoff": {"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "clubs": {
          "type": "object",
          "propertyNames": {"pattern":"^[1-9][0-9]*$"},
          "additionalProperties": {
            "type": "array",
            "prefixItems": [
              {"$ref":"#/$defs/nullablePercentage"},
              {"$ref":"#/$defs/nullablePercentage"},
              {"$ref":"#/$defs/nullablePercentage"}
            ],
            "minItems": 3,
            "maxItems": 3
          }
        }
      },
      "required": ["date","cutoff","clubs"]
    },
    "club_history": {
      "type": "object",
      "properties": {
        "season": {"$ref":"#/$defs/season"},
        "fields": {"const":["rating","attack","defense"]},
        "weeks": {"type":"array","items":{"$ref":"#/$defs/week"},"minItems":0}
      },
      "required": ["season","fields","weeks"]
    }
  }
}
